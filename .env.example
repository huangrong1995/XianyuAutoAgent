# ===========================================
# 闲鱼自动托管工具 - 环境配置
# ===========================================

# -------- 必需配置 --------

# 闲鱼 Cookies（从网页端获取）
COOKIES_STR=your_cookies_here

# 百炼 API Key（百炼/通义千问平台获取，用于远程模式）
API_KEY=your_api_key_here

# -------- 模型配置 --------

# 远程模型 API 地址（百炼）
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 远程模型名称（qwen-max / qwen-plus / gpt-4 等）
MODEL_NAME=qwen-max

# -------- 本地模型配置（作为远程模型的备用）--------
# 默认使用远程百炼模型，本地模型仅在远程失败时兜底
# 设置 USE_LOCAL_MODEL=True 可启用本地模型优先策略

# 是否启用本地模型（True/False）
USE_LOCAL_MODEL=False

# 本地 Ollama API 地址
LOCAL_MODEL_BASE_URL=http://localhost:11434/v1

# 本地模型名称（7~9B 推荐 qwen2.5:7b / deepseek-llm:8b）
LOCAL_MODEL_NAME=qwen2.5:7b

# -------- 可选配置 --------

# 人工接管切换关键词（默认句号，输入句号切换人工/AI）
TOGGLE_KEYWORDS=。

# 是否模拟人工打字延迟（True/False）
SIMULATE_HUMAN_TYPING=False

# -------- 高级配置（一般无需修改）--------

# 心跳间隔（秒，默认15）
# HEARTBEAT_INTERVAL=15

# 心跳超时（秒，默认5）
# HEARTBEAT_TIMEOUT=5

# Token刷新间隔（秒，默认3600）
# TOKEN_REFRESH_INTERVAL=3600

# Token重试间隔（秒，默认300）
# TOKEN_RETRY_INTERVAL=300

# 人工接管超时时间（秒，默认3600）
# MANUAL_MODE_TIMEOUT=3600

# 消息过期时间（毫秒，默认300000即5分钟）
# MESSAGE_EXPIRE_TIME=300000

# 日志级别（DEBUG/INFO/WARNING/ERROR，默认WARNING）
# LOG_LEVEL=WARNING

# 待上架商品检查间隔（秒，默认600即10分钟）
# PENDING_CHECK_INTERVAL=600
